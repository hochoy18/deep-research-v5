# Backend environment template — copy to `.env` and edit.
# Per ADR 0002, no URL or credential is hard-coded; everything routes through
# the environment.

# --- Database ---------------------------------------------------------------
# Production: postgresql+psycopg://user:pass@host:5432/app_db
# Tests:     sqlite:///./test.db (file) or sqlite:///:memory: (in-process)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_db

# --- Auth / JWT -------------------------------------------------------------
# HS256 secret. Use `python -c 'import secrets; print(secrets.token_urlsafe(48))'`
# to generate one. NEVER commit a real value.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400

# --- App environment --------------------------------------------------------
# `dev` enables demo seeding; everything else fails closed.
APP_ENV=production

# Browser origins allowed to call this API, comma-separated. The Next.js
# dev server is a separate origin, so without this every browser request
# is blocked before it reaches a route. Unset means CORS is off entirely
# (never `*` — the API is bearer-authenticated).
CORS_ORIGINS=http://localhost:3000

# --- Plan generation (LLM seam) ---------------------------------------------
# `dashscope` (default) talks to DashScope's OpenAI-compatible HTTP API.
# `stub` returns a deterministic in-repo Plan so the vertical slice runs
# offline in dev, demo, and tests.
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_REQUEST_TIMEOUT_SECONDS=60

# Prompt + model config. When all three LANGFUSE_* values are set they are
# the source of truth (per ADR 0004 the model name is never hard-coded in
# Python); otherwise the seed prompts in `app/prompts/` are used.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROMPT_CACHE_TTL_SECONDS=60

# --- Reserved (later tickets) -----------------------------------------------
# TAVILY_API_KEY=
# LANGGRAPH_CHECKPOINTS_DB_URL=