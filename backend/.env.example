# Backend environment template — copy to `.env` and edit.
# Per ADR 0002, no URL or credential is hard-coded; everything routes through
# the environment.

# --- Database ---------------------------------------------------------------
# Production: postgresql+psycopg://user:pass@host:5432/app_db
# Tests:     sqlite:///./test.db (file) or sqlite:///:memory: (in-process)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_db

# --- Auth / JWT -------------------------------------------------------------
# HS256 secret. Use `python -c 'import secrets; print(secrets.token_urlsafe(48))'`
# to generate one. NEVER commit a real value.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400

# --- App environment --------------------------------------------------------
# `dev` enables demo seeding; everything else fails closed.
APP_ENV=production

# --- Reserved (later tickets) -----------------------------------------------
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# DASHSCOPE_API_KEY=
# TAVILY_API_KEY=
# LANGGRAPH_CHECKPOINTS_DB_URL=