# Frontend env — public, no secrets. Copy to `.env.local` and edit.
#
# The browser calls the FastAPI backend directly at this base URL; there
# is no Next.js proxy. That means the backend must list this dev origin in
# its CORS_ORIGINS (backend/.env.example sets
# CORS_ORIGINS=http://localhost:3000), or every request is blocked before
# it reaches a route.
NEXT_PUBLIC_API_BASE=http://localhost:8000